{
  // Keep the exact Worker name. Existing custom domains configured in the
  // Cloudflare Dashboard are preserved by omitting the `routes` field.
  "name": "shivansh-engineering-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
